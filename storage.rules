rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Only a UID listed in Firestore's /admins collection is treated as
    // admin — being merely signed in is NOT enough. (Previously this was
    // `request.auth != null`, which meant any signed-in customer could
    // upload or delete reel videos.)
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Reel videos: anyone can watch, only the signed-in admin can upload/delete.
    match /reels/{file} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.size < 100 * 1024 * 1024
                            && request.resource.contentType.matches('video/.*');
      allow delete: if isAdmin();
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
