rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only a UID listed in /admins is treated as admin — being merely
    // signed in is NOT enough. (Previously this was `request.auth != null`,
    // which meant every signed-in customer had full admin access. See the
    // /admins collection below for how to add your admin account.)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Storefront content: anyone can read, only signed-in admin can write
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /slides/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reels/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /collage/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery settings: checkout reads, admin writes
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: checkout validates codes (read), admin manages (write)
    match /coupons/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: customers can place an order; only admin can view/manage
    match /orders/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Product reviews: anyone can read; only a signed-in customer can post one,
    // and only as themselves. The document id must be "<productId>_<uid>", so
    // each customer can review each product once. Customers can delete their
    // own review; admin can delete/edit any (moderation).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['productId', 'uid', 'name', 'rating', 'comment', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 100
        && reviewId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 5
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // Customer accounts: a signed-in customer can manage only their own profile
    match /customers/{uid} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // Admin allowlist — add your admin account's UID here as a document
    // (Firebase console → Firestore → create collection "admins" → document
    // ID = your admin user's UID from Authentication → any field). No client,
    // including a signed-in admin, can read or write this collection directly;
    // it is only ever checked via exists() in isAdmin() above.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
