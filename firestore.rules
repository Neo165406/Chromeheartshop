rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only a UID listed in /admins is treated as admin — being merely
    // signed in is NOT enough. (Previously this was `request.auth != null`,
    // which meant every signed-in customer had full admin access. See the
    // /admins collection below for how to add your admin account.)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A new order from the checkout page. Only the fields checkout.html writes
    // are allowed, with sane sizes, so nobody can stuff random data or huge
    // documents into /orders. Status must start as 'pending' and the timestamp
    // must be the server's.
    function validNewOrder(d) {
      return d.keys().hasOnly(['orderNumber', 'customerName', 'phone', 'address', 'note', 'items',
                               'subtotal', 'deliveryZone', 'deliveryCharge', 'couponCode',
                               'discount', 'total', 'status', 'createdAt'])
        && d.keys().hasAll(['customerName', 'phone', 'address', 'items', 'total', 'status', 'createdAt'])
        && d.customerName is string && d.customerName.size() >= 1 && d.customerName.size() <= 100
        && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 30
        && d.address is string && d.address.size() >= 1 && d.address.size() <= 500
        && (!('note' in d) || (d.note is string && d.note.size() <= 500))
        && (!('orderNumber' in d) || (d.orderNumber is string && d.orderNumber.size() <= 30))
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && d.total is number && d.total >= 0 && d.total <= 10000000
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    // Storefront content: anyone can read, only signed-in admin can write
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /slides/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reels/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /collage/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu categories and sub-categories (admin -> Categories tab): the site
    // menu reads them, only the admin can change them.
    match /categories/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery settings: checkout reads, admin writes
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: checkout looks up ONE code at a time (get). Only the admin can
    // list them, so nobody can download every coupon code from the browser.
    match /coupons/{doc} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Orders: customers can place an order; only admin can view/manage
    match /orders/{doc} {
      allow create: if validNewOrder(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Sequential invoice numbers (FN1000, FN1001, ...) used by checkout.html.
    // The counter can only be created at 1001 and then only ever go up by 1.
    match /counters/{doc} {
      allow get: if doc == 'orderNumber';
      allow create: if doc == 'orderNumber'
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == 1001;
      allow update: if doc == 'orderNumber'
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1;
    }

    // Visitor counter: every device writes only its own anonymous tracking doc
    // (a random ID made by the browser — no names, phones or emails). Only the
    // admin can read the numbers or delete rows. See js/visitor-tracker.js.
    match /visitors/{deviceId} {
      allow read, delete: if isAdmin();
      allow create, update: if deviceId.size() >= 20 && deviceId.size() <= 64
        && request.resource.data.keys().hasOnly(['firstSeen', 'lastSeen', 'lastPage', 'device', 'visits', 'source'])
        && request.resource.data.lastSeen == request.time
        && request.resource.data.firstSeen is number
        && request.resource.data.device in ['Android', 'iOS', 'Desktop', 'Other']
        && request.resource.data.lastPage is string
        && request.resource.data.lastPage.size() <= 300
        && (!('visits' in request.resource.data)
            || (request.resource.data.visits is int
                && request.resource.data.visits >= 1
                && request.resource.data.visits <= 1000000))
        && (!('source' in request.resource.data)
            || (request.resource.data.source is string
                && request.resource.data.source.size() <= 100));
    }

    // Product reviews: anyone can read; only a signed-in customer can post one,
    // and only as themselves. The document id must be "<productId>_<uid>", so
    // each customer can review each product once. Customers can delete their
    // own review; admin can delete/edit any (moderation).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['productId', 'uid', 'name', 'rating', 'comment', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 100
        && reviewId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 5
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // Customer accounts: a signed-in customer can manage only their own profile
    match /customers/{uid} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // Admin allowlist — add your admin account's UID here as a document
    // (Firebase console → Firestore → create collection "admins" → document
    // ID = your admin user's UID from Authentication → any field). No client,
    // including a signed-in admin, can read or write this collection directly;
    // it is only ever checked via exists() in isAdmin() above.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
